{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test test/contact.test.tsx test/looks.test.ts test/plates.test.tsx test/scan.test.ts test/schnitt-run.test.ts",
    "test:scan": "node --import tsx scripts/scan-copy.ts",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:scan && npm run test:e2e",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rough-notation": "^0.5.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
